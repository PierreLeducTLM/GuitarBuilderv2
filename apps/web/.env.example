# Copy to .env.local and fill in. Only these two values reach the browser.
#
# Local stack: run `supabase start` (or `supabase status`) from the repository root
# and copy "API URL" and the publishable (anon) key. Hosted project: Project
# Settings → API. Supabase's Vercel integration sets both variables for you.
# The legacy name NEXT_PUBLIC_SUPABASE_ANON_KEY is still accepted for the key.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional, server-side only (never add a NEXT_PUBLIC_ prefix). While the sign-in
# screen is set aside, every visitor is signed in to this account and shares its
# builds and panels. The account must already exist in Supabase Auth. Remove both
# to bring the sign-in screen back.
SHARED_ACCOUNT_EMAIL=
SHARED_ACCOUNT_PASSWORD=
