# Copy to .env.local and fill in. Only these two values reach the browser.
#
# Local stack: run `supabase start` (or `supabase status`) from the repository root
# and copy "API URL" and the publishable (anon) key. Hosted project: Project
# Settings → API. Supabase's Vercel integration sets both variables for you.
# The legacy name NEXT_PUBLIC_SUPABASE_ANON_KEY is still accepted for the key.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
