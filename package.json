{
  "name": "guitar-builder",
  "private": true,
  "description": "Guitar Builder v2: build tracking and acoustic analysis for luthiers",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "pnpm --filter @gb/web dev",
    "build": "pnpm --filter @gb/web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "pnpm -r test",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "test:db": "bash scripts/test-db/run.sh",
    "test:e2e": "pnpm --filter @gb/web test:e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "typescript": "catalog:"
  }
}
